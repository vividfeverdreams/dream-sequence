# --- Database (Supabase Postgres) ---
# Pooled connection (port 6543, pgbouncer) for the app at runtime / serverless:
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (port 5432) for Prisma migrations:
DIRECT_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres"

AUTH_SECRET="replace-with-a-long-random-string"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Supabase Storage (rendered videos) ---
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="renders"

# --- fal.ai (the only video provider: H3 Max) ---
FAL_KEY=""

# --- Optional OpenAI story moderation/ranking ---
OPENAI_API_KEY=""
OPENAI_TEXT_MODEL="gpt-5.4-mini"

# --- Optional Twitch story input ---
TWITCH_CLIENT_ID=""
TWITCH_CLIENT_SECRET=""
# Random secret, 32-100 characters, used to authenticate EventSub webhooks.
TWITCH_EVENTSUB_SECRET=""
# Base64-encoded 32-byte key used to encrypt OAuth tokens at rest.
TWITCH_TOKEN_ENCRYPTION_KEY=""
# Must exactly match the Twitch application's registered redirect URL.
TWITCH_REDIRECT_URI=""
# Optional scheduled recovery for queued Twitch messages.
CRON_SECRET=""
